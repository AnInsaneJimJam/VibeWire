# ──────────────────────────────────────
# PostgreSQL (Sequelize)
# ──────────────────────────────────────
DB_NAME=vibewiredb
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432

# ──────────────────────────────────────
# Neo4j (Graph DB)
# ──────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ──────────────────────────────────────
# JWT Auth
# ──────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_here
